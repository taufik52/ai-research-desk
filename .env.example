# --- Firebase web app config (REQUIRED for the real AI path) -------------------
# Copy this file to `.env` and fill it in from the Firebase console:
# Firebase console > Project settings > Your apps > Web app > SDK setup.
# Creating the Firebase project is a step only Cipoz (the user) can do —
# no account/project was created by the agent.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: measurementId (Analytics is NOT required for AI Logic)
# VITE_FIREBASE_MEASUREMENT_ID=

# --- App Check ---------------------------------------------------------------
# AI Logic enforces App Check. For local development use the debug provider:
#   VITE_APPCHECK_DEBUG=true
# The first run prints a debug token in the browser console; register it in
# Firebase console > App Check > Apps > Manage debug tokens.
# For production, set a reCAPTCHA v3 site key instead:
#   VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG=true
# VITE_RECAPTCHA_SITE_KEY=

# --- Cloud model (fallback / long-document path) -----------------------------
# Gemini Developer API backend is used (free tier, no billing needed).
VITE_CLOUD_MODEL=gemini-2.5-flash-lite
